// Software House Management System — Prisma schema (v1 / MVP)
// Translated 1:1 from docs/data-model.md. See docs/architecture.md §5 for the
// money model: every monetary value is an integer in MINOR UNITS (paisa/cents)
// plus an ISO-4217 `currency` code (default "PKR"). No floating-point money.
//
// Conventions: every model has id (cuid), createdAt, updatedAt (except the
// append-only AuditLog, which has no updatedAt).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  HR
  MANAGER // reserved — no login provisioned in v1 (decisions.md D2)
  EMPLOYEE // reserved — no login provisioned in v1
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum CompType {
  FIXED // only value used in v1
  HOURLY // reserved — Phase 2
  PROJECT // reserved — Phase 2
}

enum DocumentKind {
  CV
  CONTRACT
  ID_COPY
  CERTIFICATE
  OTHER
}

enum SalaryRevisionReason {
  HIRE
  RAISE
  PROMOTION
  RATE_CHANGE
  CORRECTION
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  OTHER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
}

enum LineItemType {
  EARNING
  DEDUCTION
}

enum LineItemCategory {
  BASE
  BONUS
  OVERTIME
  TAX
  ADVANCE
  PROVIDENT_FUND
  OTHER
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

/// App login account. Admin/HR only in v1 (decisions.md D2).
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean @default(true)

  // Optional link to an Employee for future self-service (unused in v1).
  employeeId String?   @unique
  employee   Employee? @relation("EmployeeUserAccount", fields: [employeeId], references: [id])

  // Reverse relations for "who did it" fields.
  uploadedDocuments    EmployeeDocument[] @relation("DocumentUploader")
  createdSalaryRevs    SalaryRevision[]   @relation("SalaryRevisionAuthor")
  createdPayrollRuns   PayrollRun[]       @relation("PayrollRunAuthor")
  auditLogs            AuditLog[]         @relation("AuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id String @id @default(cuid())

  // Personal
  firstName   String
  lastName    String
  cnic        String   @unique
  dateOfBirth DateTime

  // Contact
  email   String?
  phone   String?
  address String?

  // Emergency
  emergencyContactName  String?
  emergencyContactPhone String?

  // Employment
  type          EmploymentType
  designationId String
  designation   Designation    @relation(fields: [designationId], references: [id])
  departmentId  String
  department    Department     @relation(fields: [departmentId], references: [id])

  // Dates
  joiningDate      DateTime
  probationEndDate DateTime?
  confirmationDate DateTime?

  status    EmployeeStatus @default(ACTIVE)
  accessLog String? // manual note, e.g. "company email / Trello issued"
  compType  CompType       @default(FIXED)

  // Relations
  documents        EmployeeDocument[]
  salaryRevisions  SalaryRevision[]
  bankDetails      BankDetail[]
  assignments      ProjectAssignment[]
  payslips         Payslip[]
  userAccount      User?               @relation("EmployeeUserAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([departmentId])
  @@index([designationId])
}

model EmployeeDocument {
  id         String       @id @default(cuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kind       DocumentKind
  fileKey    String // object-storage key (DB stores metadata, not bytes)
  fileName   String
  mimeType   String
  sizeBytes  Int

  uploadedByUserId String
  uploadedBy       User   @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

/// Effective-dated pay history. "Current" salary = latest row with effectiveDate <= today.
model SalaryRevision {
  id            String               @id @default(cuid())
  employeeId    String
  employee      Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  baseAmount    Int // minor units
  currency      String               @default("PKR")
  effectiveDate DateTime
  reason        SalaryRevisionReason

  createdByUserId String
  createdBy       User   @relation("SalaryRevisionAuthor", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, effectiveDate])
}

model BankDetail {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  accountTitle  String
  accountNumber String
  iban          String?
  bankName      String
  paymentMethod PaymentMethod @default(BANK_TRANSFER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Configurable lists
// ---------------------------------------------------------------------------

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Designation {
  id        String     @id @default(cuid())
  name      String     @unique
  isActive  Boolean    @default(true)
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id            String        @id @default(cuid())
  name          String
  clientId      String? // reserved for Phase 3 CRM (no Client model in v1)
  clientName    String? // free text until CRM exists
  status        ProjectStatus @default(PLANNING)
  startDate     DateTime?
  endDate       DateTime?
  contractValue Int? // minor units
  currency      String        @default("PKR")
  trelloUrl     String?

  assignments ProjectAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Many-to-many join between Project and Employee.
model ProjectAssignment {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectRole   String // free text, e.g. "Lead Dev", "QA"
  allocationPct Int // 0–100 (surfaced in UI; not hard-blocked in v1)
  startDate     DateTime
  endDate       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Payroll
// ---------------------------------------------------------------------------

model PayrollRun {
  id          String        @id @default(cuid())
  periodMonth String        @unique // e.g. "2026-07"
  status      PayrollStatus @default(DRAFT)

  createdByUserId String
  createdBy       User   @relation("PayrollRunAuthor", fields: [createdByUserId], references: [id])

  payslips Payslip[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payslip {
  id           String     @id @default(cuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id])

  // Snapshot from SalaryRevision at run time; all amounts in minor units.
  baseAmount  Int
  currency    String        @default("PKR")
  grossAmount Int
  taxAmount   Int
  netAmount   Int

  paymentStatus PaymentStatus @default(PENDING)
  paidAmount    Int           @default(0)
  paidAt        DateTime?

  lineItems PayslipLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model PayslipLineItem {
  id        String           @id @default(cuid())
  payslipId String
  payslip   Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  type      LineItemType
  category  LineItemCategory
  label     String
  amount    Int // minor units
  currency  String           @default("PKR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payslipId])
}

/// Configurable Pakistan salary slabs, editable in Settings without a deploy.
model TaxSlab {
  id               String  @id @default(cuid())
  fiscalYear       String // e.g. "2025-2026"
  lowerBound       Int // annual, minor units
  upperBound       Int? // null = infinity (top slab)
  fixedAmount      Int // minor units
  ratePctOverLower Decimal @db.Decimal(5, 2) // percent applied to amount over lowerBound

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fiscalYear, lowerBound])
}

// ---------------------------------------------------------------------------
// Company & audit
// ---------------------------------------------------------------------------

/// Single-row company profile (single-tenant, decisions.md D3).
model CompanyProfile {
  id              String  @id @default(cuid())
  name            String
  address         String?
  defaultCurrency String  @default("PKR")
  logoText        String // text-only logo (design-doc §3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Append-only sensitive-action log (architecture.md §4). No updatedAt.
model AuditLog {
  id          String @id @default(cuid())
  actorUserId String
  actor       User   @relation("AuditActor", fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
