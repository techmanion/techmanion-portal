# Copy to .env and adjust as needed.

# Postgres (docker-compose maps container 5432 -> host 5433)
DATABASE_URL="postgresql://portal:portal@localhost:5433/portal_dev?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Seed credentials (optional — dev defaults used if unset). Change for anything
# beyond local development.
SEED_ADMIN_EMAIL="admin@techmanion.local"
SEED_ADMIN_PASSWORD="admin1234"
SEED_HR_EMAIL="hr@techmanion.local"
SEED_HR_PASSWORD="hr1234"
